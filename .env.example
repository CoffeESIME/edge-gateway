# ════════════════════════════════════════════════════════════════════
# .env.example — Plantilla de configuración para scada-edge
#
# Instrucciones:
#   1. Copiar este archivo a ".env"  →  cp .env.example .env
#   2. Editar los valores según el entorno de despliegue.
#   3. NUNCA incluir el archivo .env real en el control de versiones.
# ════════════════════════════════════════════════════════════════════

# ── Identidad del nodo ────────────────────────────────────────────────
# Identificador único de esta instalación. Se usa en los tópicos MQTT:
#   scada/edge/{EDGE_ID}/config/upsert
#   scada/edge/{EDGE_ID}/commands/write
EDGE_ID=edge_planta_norte_01

# ── Conexión MQTT ─────────────────────────────────────────────────────
# IP o hostname del broker Mosquitto (VPS, servidor local, etc.)
MQTT_BROKER_IP=192.168.1.100

# Puerto MQTT:
#   8883 → TLS / mTLS (producción)
#   1883 → Cleartext (sólo desarrollo local)
MQTT_PORT=8883

# Credenciales de autenticación del broker (si está configurado)
MQTT_USERNAME=scada_edge_user
MQTT_PASSWORD=your_secure_password_here

# Intervalo keepalive MQTT (en segundos)
MQTT_KEEPALIVE=60

# ID del cliente MQTT (se auto-genera si se deja vacío)
MQTT_CLIENT_ID=

# Segundos entre intentos de reconexión al broker
MQTT_RECONNECT_DELAY=5.0

# ── TLS / mTLS ────────────────────────────────────────────────────────
# Habilitar TLS (true en producción, false sólo para desarrollo local)
MQTT_USE_TLS=true

# Rutas a los certificados (montados como volúmenes Docker en /certs/)
CERT_CA_PATH=/certs/ca.crt
CERT_CLIENT_PATH=/certs/edge.crt
CERT_KEY_PATH=/certs/edge.key

# ── Persistencia local ────────────────────────────────────────────────
# Ruta al archivo SQLite dentro del contenedor (montado como volumen)
DB_PATH=/data/edge_db.sqlite

# ── Motor de adquisición ──────────────────────────────────────────────
# Cada cuántos segundos el motor recarga la lista de tags desde SQLite
# y verifica que todas las tareas de polling sigan activas.
POLL_RELOAD_INTERVAL_S=30

# ── Logging ───────────────────────────────────────────────────────────
# Nivel de verbosidad: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
